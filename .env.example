# === TELEGRAM ===
# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Числовые Telegram ID администраторов через запятую (узнать свой: @userinfobot).
# Бот отвечает только им; у каждого администратора своя история чатов.
ADMIN_IDS=

# === LM STUDIO ===
LM_STUDIO_URL=http://localhost:1234
# Если в LM Studio включена авторизация — токен, иначе оставьте как есть
LM_API_TOKEN=lm-studio

# === SYSTEM ===
# Сколько секунд ждать данные от модели / загрузку модели
TIMEOUT=600
LOAD_TIMEOUT=600
# DEBUG / INFO / WARNING. Лог: bot_debug.log (до 1 МБ, 3 файла)
LOG_LEVEL=INFO

# === FEATURES ===
ENABLE_VISION=true
ENABLE_STREAMING=true

# === TUNING (необязательно) ===
# Допустимые пределы: TEMPERATURE 0–2, MAX_HISTORY ≥ 2, STREAM_UPDATE_INTERVAL ≥ 0.5 (сек), TIMEOUT ≥ 10, LOAD_TIMEOUT ≥ 30
# TEMPERATURE=0.8
# MAX_HISTORY=40
# STREAM_UPDATE_INTERVAL=1.5
# Длина контекста при загрузке модели (0 или не задано — как настроено в LM Studio)
# CONTEXT_LENGTH=0
